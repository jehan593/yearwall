<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose draws the app's real UI (see YearwallTheme); this XML theme is only what the
        manifest/system needs before the first Compose frame, painted in the same Nord Polar
        Night background so the cold-start flash doesn't show a bright default color.
    -->
    <style name="Theme.Yearwall" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
    </style>
</resources>
